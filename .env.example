# Copy to .env and fill in. Never commit the real .env.

# Required. Your Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=sk-ant-...

# Model the classifier calls. Defaults to claude-opus-5-5.
# Cheaper alternatives: claude-sonnet-5-5, claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5

# How much effort the model spends per response: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium

# Per-request timeout for a model call (Go duration syntax).
LLM_TIMEOUT=60s

# HTTP port the API listens on.
PORT=8080

# debug | info | warn | error
LOG_LEVEL=info
