# Copy to .env and fill in. Never commit the real .env.

# Which backend to call: anthropic | openai
LLM_PROVIDER=anthropic

# The key for the provider above. Only the selected one is required — the
# service refuses to start without it.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...

# Model id. Leave empty to use the provider's default:
#   anthropic -> claude-opus-5-5   (cheaper: claude-sonnet-5-5, claude-haiku-5-5)
#   openai    -> gpt-5.4-mini      (cheaper: gpt-5-nano; pricier: gpt-6-astra)
# These two defaults are NOT the same capability tier, so set this explicitly
# before comparing providers.
LLM_MODEL=

# Reasoning effort per response: low | medium | high | xhigh | max
# Both providers accept the same names.
LLM_EFFORT=medium

# Per-request timeout for a model call (Go duration syntax).
LLM_TIMEOUT=60s

# HTTP port the API listens on.
PORT=8080

# debug | info | warn | error
LOG_LEVEL=info
